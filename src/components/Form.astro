---
import { FORMS } from '../lib/forms';
const { form } = Astro.props;
const def = FORMS[form];
---
{def && (
  <form class="rc-form" data-form={form} novalidate>
    {def.fields.map((fl) => (<>
      {fl.note && (
        <div class="note">
          <strong>Terms and conditions</strong>
          <ol>{fl.note.map((n) => <li>{n}</li>)}</ol>
        </div>
      )}
      <label class:list={['field', { check: fl.type === 'checkbox' }]}>
        <span>{fl.label}{fl.required && ' *'}</span>
        {fl.type === 'textarea' ? (
          <textarea name={fl.name} rows="4"></textarea>
        ) : fl.type === 'select' ? (
          <select name={fl.name}>
            <option value="">Please choose</option>
            {fl.options?.map((o) => <option>{o}</option>)}
          </select>
        ) : (
          <input type={fl.type ?? 'text'} name={fl.name} />
        )}
        <small class="err" data-for={fl.name}></small>
      </label>
    </>))}
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn" type="submit">{def.submit}</button>
    <p class="status" role="status"></p>
  </form>
)}

<script>
  import { schemaFor, fieldErrors } from '../lib/formSchema';

  document.querySelectorAll<HTMLFormElement>('.rc-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.status')!;
    const showErrors = (errors: Record<string, string>) => {
      form.querySelectorAll<HTMLElement>('.err').forEach((el) => (el.textContent = errors[el.dataset.for!] ?? ''));
      const first = Object.keys(errors).find((k) => form.elements.namedItem(k));
      (form.elements.namedItem(first ?? '') as HTMLElement | null)?.focus();
    };

    // Double-submit guard: the button locks while sending and stays on "Sent" afterwards (17/11: the
    // same booking arrived twice, 1 second apart). Typing in the form again unlocks it for a new enquiry.
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent ?? '';
    const setStatus = (text: string, tone = '') => { status.textContent = text; status.dataset.tone = tone; };
    // Same details sent again in this browser session (e.g. after a reload): say so instead of resending.
    const SENT_KEY = 'rc-form-sent';
    const fingerprint = (formType: string, data: Record<string, string>) =>
      formType + '|' + Object.keys(data).sort().map((k) => `${k}=${data[k]}`).join('&');
    const sentBefore = (fp: string) => { try { return (JSON.parse(sessionStorage.getItem(SENT_KEY) ?? '[]') as string[]).includes(fp); } catch { return false; } };
    const remember = (fp: string) => { try { const all = JSON.parse(sessionStorage.getItem(SENT_KEY) ?? '[]') as string[]; sessionStorage.setItem(SENT_KEY, JSON.stringify([...all, fp].slice(-10))); } catch {} };

    // Back button from the thank-you page can restore this page as it was left ("Sent ✓", disabled).
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) { button.disabled = false; button.textContent = label; delete button.dataset.state; setStatus(''); }
    });

    form.addEventListener('input', () => {
      if (button.dataset.state === 'sent') { button.disabled = false; button.textContent = label; delete button.dataset.state; setStatus(''); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      const formType = form.dataset.form!;
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;

      // Inline errors in the browser; the server runs the same schema again.
      const check = schemaFor(formType)!.safeParse(data);
      if (!check.success) { showErrors(fieldErrors(check.error)); setStatus('Please fix the highlighted fields.'); return; }
      showErrors({});

      const fp = fingerprint(formType, data);
      if (sentBefore(fp)) {
        setStatus('You’ve already sent this one: we’ve got it and will be in touch soon.', 'ok');
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';
      setStatus('Sending…');
      try {
        const res = await fetch('/api/form', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, formType, page: location.pathname }),
        });
        const out = await res.json().catch(() => ({}));
        if (res.status === 422 && out.errors) { showErrors(out.errors); setStatus('Please fix the highlighted fields.'); button.disabled = false; button.textContent = label; return; }
        if (!res.ok) throw new Error(out.error ?? String(res.status));
        remember(fp);
        form.reset();
        button.textContent = 'Sent ✓';
        button.dataset.state = 'sent';
        setStatus('Thank you! Your enquiry has been sent and we’ll be in touch soon.', 'ok');
        // Each form has its own thank-you page (Nat's request; also a clean URL to count enquiries).
        location.assign(`/thank-you-${formType}/`);
      } catch (err) {
        button.disabled = false;
        button.textContent = label;
        setStatus(`Sorry, that didn’t send (${(err as Error).message}). Please call 0434 585 992.`, 'error');
      }
    });
  });
</script>

<style is:global>
  .rc-form { max-width: 720px; margin: 30px auto; display: grid; gap: 16px; }
  .rc-form .field { display: grid; gap: 4px; font-weight: 500; }
  .rc-form .field.check { grid-template-columns: auto 1fr; align-items: start; gap: 4px 10px; }
  .rc-form input, .rc-form select, .rc-form textarea { font: inherit; padding: 10px 12px; border: 1px solid #ccc; border-radius: 4px; width: 100%; }
  .rc-form .check input { width: auto; margin-top: 6px; }
  .rc-form .check .err { grid-column: 2; }
  .rc-form .err { color: var(--red); font-weight: 400; font-size: 13px; min-height: 0; }
  .rc-form .note { background: #f6f6f6; border-left: 4px solid var(--red); padding: 12px 16px; font-size: 14px; }
  .rc-form .note ol { margin: 6px 0 0; padding-left: 20px; }
  .rc-form .hp { position: absolute; left: -9999px; height: 0; width: 0; opacity: 0; }
  .rc-form .btn { border: 0; cursor: pointer; justify-self: start; }
  .rc-form .btn:disabled { opacity: .7; cursor: default; }
  .rc-form .status { margin: 0; min-height: 1.5em; }
  .rc-form .status[data-tone='ok'] { background: #eef8e6; border-left: 4px solid #357a0e; padding: 12px 16px; font-weight: 600; color: #1f4a08; }
  .rc-form .status[data-tone='error'] { background: #fdecea; border-left: 4px solid var(--red); padding: 12px 16px; }
</style>
