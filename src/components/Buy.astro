---
// Buy button: a Stripe Payment Link when one is set in the CMS, otherwise an enquiry link.
const { url = '', label = 'Buy now', soldOut = false } = Astro.props;
---
{soldOut ? <span class="sold">Sold out</span> : url ? <a class="btn" href={url} rel="noopener">{label}</a> : <a class="btn" href="/contact-form/">Enquire</a>}
<style>
  .sold { display: inline-block; padding: .5em 1.4em; border-radius: 999px; background: #eee; color: #777; font-weight: 500; }
</style>
