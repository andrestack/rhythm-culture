<!-- Parts of a designed page ease in once as they scroll into view. -->
<script>
  // Each part of a section eases in once as it scrolls into view. Content stays visible without script or with reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('reveal-on');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.bb-tile, .bb-cities, .designed > h2, .designed .blk-section__inner > h2, .designed .blk-callout, .designed .blk-col, .designed .blk-quote, .designed .blk-btn').forEach((el) => {
      if (el.closest('.blk-hero')) return; // the top photo has its own entrance
      const i = [...(el.parentElement?.children ?? [])].indexOf(el);
      el.style.setProperty('--i', String(Math.min(i, 4)));
      el.classList.add('rv');
      io.observe(el);
    });
  }
</script>
