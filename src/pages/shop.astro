---
import Base from '../layouts/Base.astro';
import Buy from '../components/Buy.astro';
import { products } from '../lib/content';

const all = products().filter((p) => p.visible);
// Class passes and vouchers first, then drums and gear.
const ORDER = ['Rhythm Culture Drum & Dance Classes', 'Vouchers & Tuition', 'African Dance/ Drum Workshop', 'Community Drum And Dance Events', 'African Drums', 'School Drum Packages', 'Percussion'];
const groups = [...new Set(all.map((p) => p.category))].sort((a, b) => (ORDER.indexOf(a) + 1 || 99) - (ORDER.indexOf(b) + 1 || 99));
const money = (v: string) => (v ? `$${Number(v).toLocaleString('en-AU', { minimumFractionDigits: Number(v) % 1 ? 2 : 0 })}` : '');
const from = (p: (typeof all)[number]) => {
  const prices = p.options.map((o) => Number(o.price)).filter(Boolean);
  return prices.length ? `from ${money(String(Math.min(...prices)))}` : '';
};
---
<Base title="Shop | Rhythm Culture" description="Class passes, gift vouchers, African drums and percussion from Rhythm Culture on the Sunshine Coast.">
  <div class="wrap shop">
    <h1>Shop</h1>
    <p class="lead">Class passes, vouchers, drums and percussion. Questions? Call <a href="tel:0434585992">0434 585 992</a>.</p>
    {groups.map((g) => (
      <section id={g.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
        <h2>{g}</h2>
        <div class="cards">
          {all.filter((p) => p.category === g).map((p) => (
            <div class="card">
              <a href={`/product/${p.slug}/`}>{p.image && <img src={p.image} alt={p.name} loading="lazy" />}</a>
              <div>
                <h3><a href={`/product/${p.slug}/`} style="color:inherit">{p.name}</a></h3>
                <p class="price">
                  {p.salePrice ? <><s>{money(p.price)}</s> <strong>{money(p.salePrice)}</strong></> : from(p) || money(p.price)}
                </p>
                {p.options.length > 0 ? <a class="btn" href={`/product/${p.slug}/`}>Choose</a> : <Buy url={p.stripeUrl} soldOut={p.soldOut} />}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .shop h1 { text-align: center; margin-top: 40px; }
  .lead { text-align: center; }
  .shop h2 { margin-top: 40px; border-bottom: 3px solid var(--green); padding-bottom: 6px; }
  .price { margin: 0 0 12px; font-weight: 700; }
  .price s { color: #888; font-weight: 400; }
  .card { display: flex; flex-direction: column; }
  .card > div { display: flex; flex-direction: column; flex: 1; }
  .card .btn, .card :global(.sold) { margin-top: auto; align-self: flex-start; }
</style>
