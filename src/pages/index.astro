---
import Base from '../layouts/Base.astro';
import HomeBigBeat from '../components/HomeBigBeat.astro';
import Reveal from '../components/Reveal.astro';
import { pages } from '../lib/content';
const home = pages().find((p) => p.link === '/')!;
---
<Base title={home.seoTitle || home.title} description={home.description}>
  <HomeBigBeat />
  <article class="content designed home-rest"><Fragment set:html={home.html} /></article>
  <Reveal />
</Base>
